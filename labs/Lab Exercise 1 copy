from math import sqrt

primes_found = []

for num in range(2, 1000001):
    num_sqrt = sqrt(num)

    primes = [2, 3, 5]

    is_prime = True

    for i in range(2, int(num_sqrt) + 1):
        if i % 2 == 0:
            pass
        elif i % 3 == 0:
            pass
        elif i % 5 == 0:
            pass
        else:
            primes.append(i)

    for prime in primes:
        if num % prime == 0 and num != prime:
            is_prime = False
            break

    if is_prime:
        primes_found.append(num)

print(f"Primes from 1 to 1000 ({len(primes_found)} total):")
print(primes_found)